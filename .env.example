# ── Database (PostgreSQL — e.g. Neon) ──────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/ai_book_studio?sslmode=require"

# ── NextAuth ───────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-random-secret"

# ── AI providers ─────────────────────────────────────────────────
# Use "openai" (default) or "ollama" for text generation.
AI_PROVIDER="openai"
OPENAI_API_KEY="sk-..."

# Ollama text generation (required when AI_PROVIDER="ollama")
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3:8b"

# ── Stripe ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Lulu print-on-demand ───────────────────────────────────────────
LULU_API_TOKEN=""
LULU_PRINT_SKU=""
LULU_CONTACT_EMAIL=""

# ── App ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Retail price used when a book has no price set (USD)
NEXT_PUBLIC_DEFAULT_PRINT_PRICE="24.99"
